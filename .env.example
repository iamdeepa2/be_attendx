# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL database
DB_NAME=attendx_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
# Hosted MySQL: enable TLS. Set DB_SSL_CA to a provider CA file to verify identity.
# DB_SSL_MODE=REQUIRED
# DB_SSL_CA=/path/to/provider-ca.pem

# CORS - frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://attendxdemo.vercel.app
